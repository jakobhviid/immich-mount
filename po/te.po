#: crates/immich-mount-linux/src/daemon.rs:374
#: apple/App/ReceivedLinks.swift:71
msgid "Not signed in to {host}"
msgstr "{host}కు సైన్ ఇన్ చేయలేదు"

#: crates/immich-mount-linux/src/daemon.rs:374
#: apple/App/ReceivedLinks.swift:71
msgid "Immich Mount is signed in to another Immich server."
