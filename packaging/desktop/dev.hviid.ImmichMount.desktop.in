[Desktop Entry]
Name=Immich Mount
Comment=Your Immich photos and videos as a drive in your file manager
Keywords=Immich;photos;videos;drive;mount;
# `immich-mount app` opens the interface native to the desktop: Kirigami on KDE Plasma, GTK elsewhere.
Exec=@BINDIR@/immich-mount app %u
Icon=dev.hviid.ImmichMount
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
MimeType=x-scheme-handler/app.immich;
