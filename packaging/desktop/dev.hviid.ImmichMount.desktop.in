[Desktop Entry]
Name=Immich Mount
Comment=Your Immich photos and videos as a drive in your file manager
Keywords=Immich;photos;videos;drive;mount;
# `immich-mount app` opens the interface native to the desktop: Kirigami on KDE Plasma, GTK elsewhere.
Exec=@BINDIR@/immich-mount app %u
Icon=dev.hviid.ImmichMount
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
# app.immich is the browser sign-in's redirect; immich-crosslink delivers links from other apps, which the daemon shows
# in the file manager without opening the app (https://jakob.hviid.phd/immich-crosslink/).
MimeType=x-scheme-handler/app.immich;x-scheme-handler/immich-crosslink;
X-Immich-Crosslink-Version=0.2
X-Immich-Crosslink-Shows=asset;album;person;place;page;
