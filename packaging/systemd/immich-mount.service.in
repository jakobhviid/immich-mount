[Unit]
Description=Immich Mount: your Immich photos and videos as a drive
Documentation=https://github.com/jakobhviid/immich-mount

[Service]
Type=simple
ExecStart=@BINDIR@/immich-mount daemon
Restart=on-failure
RestartSec=5
# 75: the program was upgraded, and the daemon left once idle so that the new one starts.
SuccessExitStatus=75
RestartForceExitStatus=75

[Install]
WantedBy=default.target
